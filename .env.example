# Telegram bot token from @BotFather (keep secret)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Your private Telegram chat ID, e.g. 123456789
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# Vapi Private API Key (needed to download the call recording)
VAPI_PRIVATE_API_KEY=your_vapi_private_api_key_here
# Make a long random secret, e.g. openssl rand -hex 32
WEBHOOK_SECRET=your_webhook_secret_here
